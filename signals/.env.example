# SIGNAL — copy to .env and fill in values. Never commit .env.

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/signal
# Or set individually:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=signal
# PGUSER=postgres
# PGPASSWORD=

# FRED API (required for market data and backfill)
FRED_API_KEY=

# Anthropic Claude (required for thesis engine)
ANTHROPIC_API_KEY=

# Processing (NLP batch size; default 32)
PROCESSING_BATCH_SIZE=32
# Zero-shot topic model (default: cross-encoder/nli-MiniLM2-L6-H768, ~90MB)
# ZERO_SHOT_MODEL=cross-encoder/nli-MiniLM2-L6-H768

# Optional: override config paths
# SIGNAL_CONFIG_UNIVERSE=/path/to/universe.yaml
# SIGNAL_CONFIG_SOURCES=/path/to/sources.yaml
